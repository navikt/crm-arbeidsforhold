    </flexiPageRegions>
    <flexiPageRegions>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style="font-size: 16px;"&gt;This is a case receipt (test only)&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Case receipt &#8594; document receipt &#8594; files&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;It records a request to create a case in the test receiver. This test did not send data to Public 360.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Find documents and files:&lt;/strong&gt; Open Related, then Document receipts in this case. Select a document receipt, then open its Related tab and Files to see its application document and attachments. A receipt is not a file.&lt;/p&gt;&lt;p&gt;The Files list on this case shows only files attached directly to the case. If it says 0, the document receipts can still have files.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>caseReceiptGuide</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.Operation__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>CaseService/CreateCase</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong style="font-size: 16px;"&gt;This is a document receipt (test only)&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Case receipt &#8594; document receipt &#8594; files&lt;/strong&gt;&lt;/p&gt;&lt;p&gt;It records a request to add a document to a case. The receipt is not the file itself. This test did not send data to Public 360.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Find files:&lt;/strong&gt; Open Related, then Files.&lt;/p&gt;&lt;p&gt;&lt;strong&gt;Find the case:&lt;/strong&gt; Open Details, then Parent Case. On the case receipt, Related lists its document receipts. If Parent Case is empty, this receipt is not linked to a captured case.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>documentReceiptGuide</identifier>
                <visibilityRule>
                    <criteria>
                        <leftValue>{!Record.Operation__c}</leftValue>
                        <operator>EQUAL</operator>
                        <rightValue>DocumentService/CreateDocument</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>decorate</name>
                    <value>true</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>richTextValue</name>
                    <value>&lt;p&gt;&lt;strong&gt;This is a test receipt.&lt;/strong&gt; Its operation is not recognised as a case or document request. Check Operation under Details. This test did not send data to Public 360.&lt;/p&gt;</value>
                </componentInstanceProperties>
                <componentName>flexipage:richText</componentName>
                <identifier>otherReceiptGuide</identifier>
                <visibilityRule>
                    <booleanFilter>1 AND 2</booleanFilter>
                    <criteria>
                        <leftValue>{!Record.Operation__c}</leftValue>
                        <operator>NE</operator>
                        <rightValue>CaseService/CreateCase</rightValue>
                    </criteria>
                    <criteria>
                        <leftValue>{!Record.Operation__c}</leftValue>
                        <operator>NE</operator>
                        <rightValue>DocumentService/CreateDocument</rightValue>
                    </criteria>
                </visibilityRule>
            </componentInstance>
        </itemInstances>
        <itemInstances>
            <componentInstance>
                <componentInstanceProperties>
                    <name>label</name>
                    <value>Tabs</value>
                </componentInstanceProperties>
                <componentInstanceProperties>
                    <name>tabs</name>
                    <value>ReceiptTabsFacet</value>
                </componentInstanceProperties>
                <componentName>flexipage:tabset</componentName>
                <identifier>receiptTabs</identifier>
            </componentInstance>
        </itemInstances>
        <name>main</name>
        <type>Region</type>
