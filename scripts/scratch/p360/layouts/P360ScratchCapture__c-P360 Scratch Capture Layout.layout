<?xml version="1.0" encoding="UTF-8"?>
<Layout xmlns="http://soap.sforce.com/2006/04/metadata">
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Summary (simulation only, never sent to Public 360)</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Name</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>Operation__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>Title__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>SourceRecord__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>Outcome__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>P360Number__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>ParentCapture__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>ParentCaseNumber__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>Attempts__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Everything sent to P360</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>RequestFields__c</field></layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Files</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>FileCount__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>FileDetails__c</field></layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Identity</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>ExternalSystem__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>ExternalId__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>SourceRecordId__c</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>RequestKey__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>PayloadHash__c</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsLeftToRight</style>
    </layoutSections>
    <layoutSections>
        <customLabel>true</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>true</editHeading>
        <label>Raw request and response</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>RequestBody__c</field></layoutItems>
            <layoutItems><behavior>Readonly</behavior><field>ResponseBody__c</field></layoutItems>
        </layoutColumns>
        <style>OneColumn</style>
    </layoutSections>
    <layoutSections>
        <customLabel>false</customLabel>
        <detailHeading>true</detailHeading>
        <editHeading>false</editHeading>
        <label>System Information</label>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>CreatedById</field></layoutItems>
            <layoutItems><behavior>Edit</behavior><field>OwnerId</field></layoutItems>
        </layoutColumns>
        <layoutColumns>
            <layoutItems><behavior>Readonly</behavior><field>LastModifiedById</field></layoutItems>
        </layoutColumns>
        <style>TwoColumnsTopToBottom</style>
    </layoutSections>
    <relatedLists>
        <relatedList>RelatedFileList</relatedList>
    </relatedLists>
    <relatedLists>
        <fields>NAME</fields>
        <fields>Title__c</fields>
        <fields>P360Number__c</fields>
        <fields>FileCount__c</fields>
        <fields>Outcome__c</fields>
        <relatedList>P360ScratchCapture__c.ParentCapture__c</relatedList>
    </relatedLists>
</Layout>
