<?xml version="1.0" encoding="UTF-8"?>
<CustomObject xmlns="http://soap.sforce.com/2006/04/metadata">
    <customSettingsType>Hierarchy</customSettingsType>
    <description>Scratch-only synthetic receiver configuration. Never used by the product adapter factory.</description>
    <fields>
        <fullName>Enabled__c</fullName>
        <defaultValue>false</defaultValue>
        <label>Enabled</label>
        <type>Checkbox</type>
    </fields>
    <fields>
        <fullName>Scenario__c</fullName>
        <label>Scenario</label>
        <length>40</length>
        <type>Text</type>
    </fields>
    <fields>
        <fullName>MaxFileBytes__c</fullName>
        <label>Maximum Synthetic File Bytes</label>
        <precision>5</precision>
        <scale>0</scale>
        <type>Number</type>
    </fields>
    <label>P360 Scratch Setting</label>
    <visibility>Protected</visibility>
</CustomObject>
