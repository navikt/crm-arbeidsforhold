            "enableOmniSecondaryRoutingPriority": true
        },
        "pathAssistantSettings": {
            "pathAssistantEnabled": true
        },
        "securitySettings": {
            "sessionSettings": {
                "forceRelogin": false,
                "lockerServiceNext": true
