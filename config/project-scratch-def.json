{
    "orgName": "crm-arbeidsforhold",
    "country": "NO",
    "language": "en_US",
    "edition": "Enterprise",
    "description": "Dette er ein utviklings scratch-org brukt for å utvikle løsninger til Arbeidsforhold.",
    "features": [
        "AddCustomApps:30",
